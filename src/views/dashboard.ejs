<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard Administrador</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>

    <header>
        <h1>Panel de Administracion</h1>

        <div class="usuario-header">
            <span>Administrador</span>
            <button onclick="window.location.href='/'">Salir</button>
        </div>
    </header>

    <div class="pantalla-bienvenida">
        
        <p>Bienvenido al administrador del Kiosco Tecnológico.</p>

        <h2>Gestión de productos</h2>

        <button onclick="window.location.href='/admin/productos'">
            Ver productos
        </button>

        <button onclick="window.location.href='/admin/productos/alta'">
            Agregar producto
        </button>

        <button onclick="window.location.href='/admin/productos/darBaja'">
            Dar de baja productos
        </button>

        <button onclick="window.location.href='/admin/productos/reactivar'">
            Reactivar productos
        </button>
    </div>

</body>
</html>