<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Nuevo Producto - Admin</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>

    <header>
        <h1>Panel de Administración - Nuevo Producto</h1>
    </header>

    <div class="contenedor-principal">
        <div class="seccion-formulario-editar">

            <div class="encabezado-form">
                <h2>Crear Nuevo Producto</h2>
                <a href="/admin/productos" class="btn-volver">← Volver al listado</a>
            </div>

            <form action="/admin/productos/alta" method="POST" enctype="multipart/form-data" class="form-editar-grid">
                
                <!-- Columna Izquierda: Vista previa de la imagen cargada -->
                <div class="panel-previsualizacion">
                    <h3>Vista Previa</h3>
                    <div class="contenedor-imagen-actual">
                        <img src="/img/default.png" alt="Vista previa" id="imgPreview" class="img-preview-admin">
                    </div>
                    <p><small>Sube una imagen para verla aquí en tiempo real.</small></p>
                </div>

                <!-- Columna Derecha: Campos del formulario organizados -->
                <div class="panel-campos">
                    
                    <div class="campo-grupo">
                        <label for="nombre">Nombre del producto:</label>
                        <input type="text" id="nombre" name="nombre" placeholder="Ej. Teclado Mecánico" required>
                    </div>

                    <div class="campo-grupo">
                        <label for="tipo">Categoría / Tipo:</label>
                        <select id="tipo" name="tipo" required>
                            <option value="perifericos">Periféricos</option>
                            <option value="escritorio">Escritorio</option>
                        </select>
                    </div>

                    <div class="campo-grupo">
                        <label for="precio">Precio ($ ARS):</label>
                        <input type="number" step="0.01" id="precio" name="precio" placeholder="0.00" required>
                    </div>

                    <div class="campo-grupo">
                        <label for="stock">Stock inicial:</label>
                        <input type="number" id="stock" name="stock" placeholder="10" required>
                        <small class="texto-ayuda">Si el stock es 0 o menor, el producto se creará inactivo.</small>
                    </div>

                    <div class="campo-grupo">
                        <label for="imagenArchivo">Imagen del producto (Seleccionar archivo):</label>
                        <input type="file" id="imagenArchivo" name="imagenArchivo" accept="image/*" onchange="verPrevia(event)" required>
                    </div>

                    <div class="campo-grupo">
                        <label for="tamanoImagen">Tamaño de visualización en catálogo:</label>
                        <select id="tamanoImagen" name="tamanoImagen" class="select-tamano">
                            <option value="normal">Normal (Estándar)</option>
                            <option value="compacto">Compacto (Pequeña)</option>
                            <option value="destacado">Destacado (Grande)</option>
                        </select>
                    </div>

                    <div class="botones-form-acciones">
                        <button type="submit" class="btn-guardar">Crear Producto</button>
                        <a href="/admin/productos" class="btn-cancelar">Cancelar</a>
                    </div>

                </div>

            </form>
        </div>
    </div>

    <!-- Script para previsualizar la imagen seleccionada -->
    <script>
        function verPrevia(event) {
            const archivo = event.target.files[0];
            if (archivo) {
                const lector = new FileReader();
                lector.onload = function(e) {
                    document.getElementById('imgPreview').src = e.target.result;
                }
                lector.readAsDataURL(archivo);
            }
        }
        (function () {
        const temaGuardado = localStorage.getItem('theme') || 'light';
        document.documentElement.setAttribute('data-theme', temaGuardado);
        })();
    </script>

</body>
</html>