<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login Administrador</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>

    <div class="pantalla-bienvenida">
        <div class="login-card-admin">
            <h1>Acceso Administrador</h1>

            <form action="/admin/login" method="POST" class="form-login-admin">
                <div class="campo-login-grupo">
                    <label for="correo">Correo electrónico</label>
                    <input
                        type="email"
                        id="correo"
                        name="correo"
                        placeholder="admin@gmail.com"
                        required
                    >
                </div>

                <div class="campo-login-grupo">
                    <label for="contrasena">Contraseña</label>
                    <input
                        type="password"
                        id="contrasena"
                        name="contrasena"
                        placeholder="••••••••"
                        required
                    >
                </div>

                <button type="submit" class="btn-ingresar-admin">Ingresar</button>
            </form>
            <a href="/" class="btn-volver-login">Volver</a>
        </div>
    </div>

</body>
</html>