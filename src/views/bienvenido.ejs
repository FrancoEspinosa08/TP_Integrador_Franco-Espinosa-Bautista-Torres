<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Bienvenido - Kiosco Tecnológico</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>

    <div class="pantalla-bienvenida">

        <h1>Bienvenido al Kiosco Tecnológico</h1>

        <p>Seleccione cómo desea ingresar</p>

        <input type="text" id="nombre-cliente" placeholder="Ingrese su nombre">

        <button onclick="continuarAProductos()">
