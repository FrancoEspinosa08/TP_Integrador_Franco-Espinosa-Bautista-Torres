<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Gestión de Productos - Admin</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>

    <header>
        <div class="admin-titulo">
            <h2>Panel de Administración - Kiosco Tecnológico</h2>
        </div>
        
        <div class="admin-user-info">
            <span class="admin-badge">Admin</span>
            <span id="reloj-admin" class="admin-reloj">Expira en: 02:00:00</span>
            <!-- Limpiamos el sessionStorage antes de ir a la ruta de logout -->
            <a href="/admin/logout" class="btn-logout" onclick="sessionStorage.removeItem('tokenExpiry');">Cerrar Sesión</a>
        </div>
    </header>

    <div class="contenedor-principal">
        <div class="seccion-catalogo admin-productos">

            <div class="encabezado-admin-productos">
                <h2>Lista de Productos</h2>

                <div class="botones-admin">
                    <button class="btn-nuevo-producto" onclick="window.location.href='/admin/productos/alta'">
                        + Nuevo Producto
                    </button>

                    <button class="btn-volver-admin" onclick="window.location.href='/'">
                        Volver al Panel
                    </button>
                </div>
            </div>

            <!-- Buscador por ID -->
            <div class="buscador-container">
                <form action="/admin/productos" method="GET" class="form-buscador">
                    <input type="number" name="buscarId" placeholder="Buscar por ID (Ej. 3)" value="<%= buscarId %>" class="input-buscador" required>
                    <button type="submit" class="btn-buscar">Buscar</button>
                    <% if (buscarId) { %>
                        <a href="/admin/productos" class="btn-limpiar">Limpiar</a>
                    <% } %>
                </form>
            </div>

            <!-- Tabla de administración paginada -->
            <div class="tabla-contenedor">
                <table class="tabla-admin">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Imagen</th>
                            <th>Nombre</th>
                            <th>Precio</th>
                            <th>Stock</th>
                            <th>Estado</th>
                            <th class="text-center">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (productos && productos.length > 0) { %>
                            <% productos.forEach((producto) => {
                                const claseFila = producto.activo ? '' : 'fila-inactiva';
                                const claseBtn = producto.activo ? 'btn-accion-rojo' : 'btn-accion-verde';
                                const textoBtn = producto.activo ? 'Dar de baja' : 'Reactivar';
                                const estadoTexto = producto.activo ? 'Activo' : 'Dado de baja';
                            %>
                                <tr class="<%= claseFila %>">
                                    <td>#<%= producto.id %></td>
                                    <td>
                                        <img class="img-admin" src="<%= producto.imagen %>" alt="<%= producto.nombre %>">
                                    </td>
                                    <td class="nombre-producto"><%= producto.nombre %></td>
                                    <td>$<%= producto.precio.toLocaleString('es-AR') %></td>
                                    <td><%= producto.stock %></td>
                                    <td><strong><%= estadoTexto %></strong></td>
                                    <td>
                                        <div class="acciones-container">
                                            <button class="btn-editar-producto" onclick="window.location.href='/admin/productos/editar/<%= producto.id %>'">
                                                Editar
                                            </button>

                                            <form action="/admin/productos/estado/<%= producto.id %>" method="POST" class="form-inline-admin">
                                                <button type="submit" class="<%= claseBtn %>">
                                                    <%= textoBtn %>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr>
                                <td colspan="7" class="text-center">No se encontró ningún producto con ese ID.</td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>

            <!-- Controles de Paginación -->
            <% if (totalPaginas > 1 && !buscarId) { %>
                <div class="paginacion">
                    <% if (paginaActual > 1) { %>
                        <a href="/admin/productos?page=<%= paginaActual - 1 %>" class="btn-paginacion">Anterior</a>
                    <% } %>

                    <% for (let i = 1; i <= totalPaginas; i++) { %>
                        <a href="/admin/productos?page=<%= i %>" class="btn-paginacion <%= paginaActual === i ? 'activo' : '' %>"><%= i %></a>
                    <% } %>

                    <% if (paginaActual < totalPaginas) { %>
                        <a href="/admin/productos?page=<%= paginaActual + 1 %>" class="btn-paginacion">Siguiente</a>
                    <% } %>
                </div>
            <% } %>

        </div>
    </div>

    <script src="/js/script.js"></script>
</body>
</html>
