
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Gestión de Productos - Admin</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>

    <header>
        <h1>Panel de Administración - Productos</h1>
    </header>

    <div class="contenedor-principal">
        <div class="seccion-catalogo admin-productos">

            <div class="encabezado-admin-productos">
                <h2>Lista de Productos</h2>

                <div class="botones-admin">
                    <button class="btn-nuevo-producto" onclick="window.location.href='/admin/productos/alta'">
                        + Nuevo Producto
                    </button>

                    <button class="btn-volver-admin" onclick="window.location.href='/'">
                        Volver al Panel
                    </button>
                </div>
            </div>

            <div class="grilla-productos">
                <% productos.forEach((producto) => {
                    const claseTarjeta = producto.activo ? 'tarjeta-producto-activa' : 'tarjeta-producto-inactiva';
                    const claseBtn = producto.activo ? 'btn-accion-rojo' : 'btn-accion-verde';
                    const textoBtn = producto.activo ? 'Dar de baja' : 'Activar';
                    const estadoTexto = producto.activo ? 'Activo' : 'Dado de baja';
                %>

                    <div class="tarjeta-producto <%= claseTarjeta %>">

                        <img class="imagen-producto-admin" src="<%= producto.imagen %>" alt="<%= producto.nombre %>">

                        <div>
                            <h3><%= producto.nombre %></h3>

                            <p class="precio-producto">
                                $<%= producto.precio.toLocaleString('es-AR') %>
                            </p>

                            <p>
                                <small>
                                    Stock: <%= producto.stock %> |
                                    Estado: <strong><%= estadoTexto %></strong>
                                </small>
                            </p>
                        </div>

                        <div class="botones-acciones-producto">

                            <button class="btn-editar-producto" onclick="window.location.href='/admin/productos/editar/<%= producto.id %>'">
                                Editar
                            </button>

                            <form action="/admin/productos/estado/<%= producto.id %>" method="POST">
                                <button type="submit" class="<%= claseBtn %>">
                                    <%= textoBtn %>
                                </button>
                            </form>

                        </div>

                    </div>

                <% }) %>
            </div>

        </div>
    </div>

</body>
</html>
