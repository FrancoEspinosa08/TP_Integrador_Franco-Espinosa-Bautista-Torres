<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Editar Producto</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>

    <div class="pantalla-bienvenida">
        <h1>Editar Producto</h1>

        <form action="/admin/productos/editar/<%= producto.id %>" method="POST">
            <input type="text" name="nombre" value="<%= producto.nombre %>" placeholder="Nombre" required>

            <select name="tipo" required>
                <option value="perifericos" <%= producto.tipo === 'perifericos' ? 'selected' : '' %>>Periféricos</option>
                <option value="escritorio" <%= producto.tipo === 'escritorio' ? 'selected' : '' %>>Escritorio</option>
            </select>

            <input type="number" step="0.01" name="precio" value="<%= producto.precio %>" placeholder="Precio" required>
            <input type="number" name="stock" value="<%= producto.stock %>" placeholder="Stock" required>
            <input type="text" name="imagen" value="<%= producto.imagen %>" placeholder="URL de la imagen" required>

            <button type="submit" style="background: #16a34a;">Guardar Cambios</button>
        </form>

        <button onclick="window.location.href='/admin/productos'" style="margin-top: 10px; background-color: #64748b;">
            Cancelar
        </button>
    </div>

</body>
</html>